@model CarAgence.Domain.Entities.Reservation

@{ ViewData["Title"] = $"Modifier reservation #{Model.Id}"; }

<div class="max-w-xl">
    <form asp-action="Edit" class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-4 py-3"></div>
        <input type="hidden" asp-for="Id" />
        <div class="space-y-4">
            <div>
                <label asp-for="ClientId" class="block text-sm font-medium text-gray-700 mb-1">Client</label>
                <select asp-for="ClientId" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Clients)" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors bg-white">
                </select>
                <span asp-validation-for="ClientId" class="text-sm text-red-600 mt-1 block"></span>
            </div>
            <div>
                <label asp-for="VoitureId" class="block text-sm font-medium text-gray-700 mb-1">Voiture</label>
                <select asp-for="VoitureId" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Voitures)" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors bg-white">
                </select>
                <span asp-validation-for="VoitureId" class="text-sm text-red-600 mt-1 block"></span>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="DateDebut" class="block text-sm font-medium text-gray-700 mb-1">Date de debut</label>
                    <input asp-for="DateDebut" type="date" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors" />
                    <span asp-validation-for="DateDebut" class="text-sm text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="DateFin" class="block text-sm font-medium text-gray-700 mb-1">Date de fin</label>
                    <input asp-for="DateFin" type="date" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors" />
                    <span asp-validation-for="DateFin" class="text-sm text-red-600 mt-1 block"></span>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-3 mt-6">
            <button type="submit" class="bg-brand-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-brand-700 transition-colors">Enregistrer</button>
            <a asp-action="Index" class="text-gray-600 hover:text-gray-900 px-4 py-2 text-sm font-medium transition-colors">Annuler</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
