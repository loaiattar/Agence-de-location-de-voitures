@model IEnumerable<CarAgence.Domain.Entities.Reservation>

@{ ViewData["Title"] = "Reservations"; }

<h1>Reservations</h1>
<p><a asp-action="Create" class="btn btn-primary">Nouvelle reservation</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Client</th>
            <th>Voiture</th>
            <th>Date debut</th>
            <th>Date fin</th>
            <th>Duree</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            var duree = (r.DateFin - r.DateDebut).Days;
            var enCours = r.DateDebut <= DateTime.Today && r.DateFin >= DateTime.Today;
            <tr class="@(enCours ? "table-success" : "")">
                <td>@r.Client?.Prenom @r.Client?.Nom</td>
                <td>@r.Voiture?.Immatriculation - @r.Voiture?.Modele?.Marque?.Nom @r.Voiture?.Modele?.Nom</td>
                <td>@r.DateDebut.ToString("dd/MM/yyyy")</td>
                <td>@r.DateFin.ToString("dd/MM/yyyy")</td>
                <td>@duree jour(s)@(enCours ? " (en cours)" : "")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Modifier</a>
                    <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>
