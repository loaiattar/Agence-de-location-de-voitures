@model CarAgence.Domain.Entities.Reservation

@{ ViewData["Title"] = $"Reservation #{Model.Id}"; }

<div class="max-w-xl">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
        <div class="space-y-3">
            <div>
                <span class="text-sm font-medium text-gray-500">Client</span>
                <p class="text-gray-900 font-medium">@Model.Client?.Prenom @Model.Client?.Nom</p>
            </div>
            <div>
                <span class="text-sm font-medium text-gray-500">Email</span>
                <p class="text-gray-900">@Model.Client?.Email</p>
            </div>
            <div>
                <span class="text-sm font-medium text-gray-500">Voiture</span>
                <p class="text-gray-900">@Model.Voiture?.Immatriculation - @Model.Voiture?.Modele?.Marque?.Nom @Model.Voiture?.Modele?.Nom</p>
            </div>
            <div>
                <span class="text-sm font-medium text-gray-500">Tarif journalier</span>
                <p class="text-gray-900">@Model.Voiture?.TarifJournalier €</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <span class="text-sm font-medium text-gray-500">Date debut</span>
                    <p class="text-gray-900">@Model.DateDebut.ToString("dd/MM/yyyy")</p>
                </div>
                <div>
                    <span class="text-sm font-medium text-gray-500">Date fin</span>
                    <p class="text-gray-900">@Model.DateFin.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
            <div>
                <span class="text-sm font-medium text-gray-500">Duree</span>
                <p class="text-gray-900">@((Model.DateFin - Model.DateDebut).Days) jour(s)</p>
            </div>
            <div class="pt-3 border-t border-gray-200">
                <span class="text-sm font-medium text-gray-500">Montant total</span>
                <p class="text-2xl font-bold text-brand-600">@Model.GetMontantTotal() €</p>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="inline-block text-gray-600 hover:text-gray-900 text-sm font-medium transition-colors">&larr; Retour</a>
</div>
