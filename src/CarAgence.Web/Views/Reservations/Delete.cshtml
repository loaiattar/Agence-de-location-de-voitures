@model CarAgence.Domain.Entities.Reservation

@{ ViewData["Title"] = "Supprimer reservation"; }

<div class="max-w-xl">
    <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-6 py-4 mb-6">
        <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-amber-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
            <p class="font-medium">Etes-vous sur de vouloir supprimer cette reservation ?</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
        <div class="space-y-3">
            <div>
                <span class="text-sm font-medium text-gray-500">Client</span>
                <p class="text-gray-900 font-medium">@Model.Client?.Prenom @Model.Client?.Nom</p>
            </div>
            <div>
                <span class="text-sm font-medium text-gray-500">Voiture</span>
                <p class="text-gray-900">@Model.Voiture?.Immatriculation - @Model.Voiture?.Modele?.Marque?.Nom @Model.Voiture?.Modele?.Nom</p>
            </div>
            <div>
                <span class="text-sm font-medium text-gray-500">Periode</span>
                <p class="text-gray-900">@Model.DateDebut.ToString("dd/MM/yyyy") - @Model.DateFin.ToString("dd/MM/yyyy")</p>
            </div>
        </div>
    </div>

    <form asp-action="Delete" class="flex items-center gap-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-red-700 transition-colors">Supprimer</button>
        <a asp-action="Index" class="text-gray-600 hover:text-gray-900 px-4 py-2 text-sm font-medium transition-colors">Annuler</a>
    </form>
</div>
