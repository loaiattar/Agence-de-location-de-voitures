@model CarAgence.Domain.Entities.Marque

@{ ViewData["Title"] = Model.Nom; }

<div class="max-w-xl">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
        <div class="space-y-3">
            <div>
                <span class="text-sm font-medium text-gray-500">Nom</span>
                <p class="text-gray-900 font-medium">@Model.Nom</p>
            </div>
            <div>
                <span class="text-sm font-medium text-gray-500">Pays</span>
                <p class="text-gray-900">@(Model.PaysOrigine ?? "-")</p>
            </div>
        </div>
    </div>

    <h3 class="text-lg font-semibold text-gray-900 mb-3">Modeles</h3>
    @if (Model.Modeles.Any())
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 divide-y divide-gray-100">
            @foreach (var modele in Model.Modeles)
            {
                <a asp-controller="Modeles" asp-action="Details" asp-route-id="@modele.Id"
                   class="flex items-center justify-between px-6 py-4 hover:bg-gray-50 transition-colors">
                    <span class="text-sm font-medium text-gray-900">@modele.Nom</span>
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
            }
        </div>
    }
    else
    {
        <p class="text-gray-500 text-sm">Aucun modele pour cette marque.</p>
    }

    <a asp-action="Index" class="inline-block mt-6 text-gray-600 hover:text-gray-900 text-sm font-medium transition-colors">&larr; Retour</a>
</div>
