@model CarAgence.Domain.Entities.Marque

@{ ViewData["Title"] = $"Supprimer - {Model.Nom}"; }

<h1>Supprimer la marque</h1>

<div class="alert alert-warning">
    <h5>Etes-vous sur de vouloir supprimer cette marque ?</h5>
</div>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Nom :</strong> @Model.Nom</p>
        <p><strong>Pays :</strong> @(Model.PaysOrigine ?? "-")</p>
        <p><strong>Modeles :</strong> @Model.Modeles.Count</p>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Supprimer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>
