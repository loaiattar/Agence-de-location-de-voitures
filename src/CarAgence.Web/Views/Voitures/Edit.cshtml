@model CarAgence.Domain.Entities.Voiture

@{ ViewData["Title"] = $"Modifier - {Model.Immatriculation}"; }

<div class="max-w-xl">
    <form asp-action="Edit" class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-4 py-3"></div>
        <input type="hidden" asp-for="Id" />
        <div class="space-y-4">
            <div>
                <label asp-for="Immatriculation" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Immatriculation" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors" />
                <span asp-validation-for="Immatriculation" class="text-sm text-red-600 mt-1 block"></span>
            </div>
            <div>
                <label asp-for="ModeleId" class="block text-sm font-medium text-gray-700 mb-1">Modele</label>
                <select asp-for="ModeleId" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Modeles)" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors bg-white">
                </select>
                <span asp-validation-for="ModeleId" class="text-sm text-red-600 mt-1 block"></span>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="Annee" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Annee" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors" />
                    <span asp-validation-for="Annee" class="text-sm text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="TarifJournalier" class="block text-sm font-medium text-gray-700 mb-1">Tarif journalier (€)</label>
                    <input asp-for="TarifJournalier" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors" />
                    <span asp-validation-for="TarifJournalier" class="text-sm text-red-600 mt-1 block"></span>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="NombrePlaces" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="NombrePlaces" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors" />
                    <span asp-validation-for="NombrePlaces" class="text-sm text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Carburant" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <select asp-for="Carburant" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors bg-white">
                        <option value="Essence">Essence</option>
                        <option value="Diesel">Diesel</option>
                        <option value="Electrique">Electrique</option>
                        <option value="Hybride">Hybride</option>
                    </select>
                    <span asp-validation-for="Carburant" class="text-sm text-red-600 mt-1 block"></span>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-3 mt-6">
            <button type="submit" class="bg-brand-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-brand-700 transition-colors">Enregistrer</button>
            <a asp-action="Index" class="text-gray-600 hover:text-gray-900 px-4 py-2 text-sm font-medium transition-colors">Annuler</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
