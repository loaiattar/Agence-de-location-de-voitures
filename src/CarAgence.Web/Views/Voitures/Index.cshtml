@model IEnumerable<CarAgence.Domain.Entities.Voiture>

@{ ViewData["Title"] = "Voitures"; }

<h1>Voitures</h1>
<p><a asp-action="Create" class="btn btn-primary">Ajouter une voiture</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Immatriculation</th>
            <th>Marque</th>
            <th>Modele</th>
            <th>Annee</th>
            <th>Tarif/j</th>
            <th>Places</th>
            <th>Carburant</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.Immatriculation</td>
                <td>@v.Modele?.Marque?.Nom</td>
                <td>@v.Modele?.Nom</td>
                <td>@v.Annee</td>
                <td>@v.TarifJournalier €</td>
                <td>@v.NombrePlaces</td>
                <td>@v.Carburant</td>
                <td>
                    <a asp-action="Details" asp-route-id="@v.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary">Modifier</a>
                    <a asp-action="Delete" asp-route-id="@v.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>
