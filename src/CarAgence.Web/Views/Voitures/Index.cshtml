@model IEnumerable<CarAgence.Domain.Entities.Voiture>

@{ ViewData["Title"] = "Voitures"; }

<div class="flex items-center justify-between mb-6">
    <div>
        <p class="text-gray-500">@Model.Count() voiture(s)</p>
    </div>
    <a asp-action="Create" class="inline-flex items-center gap-2 bg-brand-600 text-white px-4 py-2.5 rounded-lg text-sm font-medium hover:bg-brand-700 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Ajouter une voiture
    </a>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase tracking-wider">Immatriculation</th>
                    <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase tracking-wider">Marque</th>
                    <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase tracking-wider">Modele</th>
                    <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase tracking-wider">Annee</th>
                    <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase tracking-wider">Tarif/j</th>
                    <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase tracking-wider">Places</th>
                    <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase tracking-wider">Carburant</th>
                    <th class="px-6 py-3 text-right font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var v in Model)
                {
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 font-medium text-gray-900">@v.Immatriculation</td>
                        <td class="px-6 py-4 text-gray-600">@v.Modele?.Marque?.Nom</td>
                        <td class="px-6 py-4 text-gray-600">@v.Modele?.Nom</td>
                        <td class="px-6 py-4 text-gray-600">@v.Annee</td>
                        <td class="px-6 py-4 text-gray-600 font-medium">@v.TarifJournalier €</td>
                        <td class="px-6 py-4 text-gray-600">@v.NombrePlaces</td>
                        <td class="px-6 py-4"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">@v.Carburant</span></td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-action="Details" asp-route-id="@v.Id" class="text-gray-500 hover:text-gray-700 p-1.5 rounded-lg hover:bg-gray-100 transition-colors" title="Details">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                </a>
                                <a asp-action="Edit" asp-route-id="@v.Id" class="text-brand-600 hover:text-brand-800 p-1.5 rounded-lg hover:bg-brand-50 transition-colors" title="Modifier">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                </a>
                                <a asp-action="Delete" asp-route-id="@v.Id" class="text-red-600 hover:text-red-800 p-1.5 rounded-lg hover:bg-red-50 transition-colors" title="Supprimer">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
