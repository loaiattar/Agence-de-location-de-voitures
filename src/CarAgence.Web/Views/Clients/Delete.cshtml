@model CarAgence.Domain.Entities.Client

@{ ViewData["Title"] = $"Supprimer - {Model.Prenom} {Model.Nom}"; }

<h1>Supprimer le client</h1>

<div class="alert alert-warning">
    <h5>Etes-vous sur de vouloir supprimer ce client ?</h5>
</div>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Nom :</strong> @Model.Nom</p>
        <p><strong>Prenom :</strong> @Model.Prenom</p>
        <p><strong>Email :</strong> @Model.Email</p>
        <p><strong>Telephone :</strong> @(Model.Telephone ?? "-")</p>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Supprimer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>
