@model IEnumerable<CarAgence.Domain.Entities.Client>

@{ ViewData["Title"] = "Clients"; }

<h1>Clients</h1>
<p><a asp-action="Create" class="btn btn-primary">Ajouter un client</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Prenom</th>
            <th>Email</th>
            <th>Telephone</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model)
        {
            <tr>
                <td>@client.Nom</td>
                <td>@client.Prenom</td>
                <td>@client.Email</td>
                <td>@(client.Telephone ?? "-")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-primary">Modifier</a>
                    <a asp-action="Delete" asp-route-id="@client.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>
