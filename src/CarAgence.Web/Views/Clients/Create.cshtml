@model CarAgence.Domain.Entities.Client

@{ ViewData["Title"] = "Ajouter un client"; }

<div class="max-w-xl">
    <form asp-action="Create" class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-4 py-3"></div>
        <div class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="Nom" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Nom" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors" />
                    <span asp-validation-for="Nom" class="text-sm text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Prenom" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Prenom" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors" />
                    <span asp-validation-for="Prenom" class="text-sm text-red-600 mt-1 block"></span>
                </div>
            </div>
            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Email" type="email" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors" />
                <span asp-validation-for="Email" class="text-sm text-red-600 mt-1 block"></span>
            </div>
            <div>
                <label asp-for="Telephone" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Telephone" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-colors" />
                <span asp-validation-for="Telephone" class="text-sm text-red-600 mt-1 block"></span>
            </div>
        </div>
        <div class="flex items-center gap-3 mt-6">
            <button type="submit" class="bg-brand-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-brand-700 transition-colors">Ajouter</button>
            <a asp-action="Index" class="text-gray-600 hover:text-gray-900 px-4 py-2 text-sm font-medium transition-colors">Annuler</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
