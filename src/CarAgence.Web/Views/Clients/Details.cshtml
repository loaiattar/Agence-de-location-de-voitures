@model CarAgence.Domain.Entities.Client

@{ ViewData["Title"] = $"{Model.Prenom} {Model.Nom}"; }

<div class="max-w-xl">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
        <div class="space-y-3">
            <div>
                <span class="text-sm font-medium text-gray-500">Nom complet</span>
                <p class="text-gray-900 font-medium">@Model.Prenom @Model.Nom</p>
            </div>
            <div>
                <span class="text-sm font-medium text-gray-500">Email</span>
                <p class="text-gray-900">@Model.Email</p>
            </div>
            <div>
                <span class="text-sm font-medium text-gray-500">Telephone</span>
                <p class="text-gray-900">@(Model.Telephone ?? "-")</p>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="inline-block text-gray-600 hover:text-gray-900 text-sm font-medium transition-colors">&larr; Retour</a>
</div>
