@model CarAgence.Domain.Entities.Modele

@{ ViewData["Title"] = $"Supprimer - {Model.Nom}"; }

<h1>Supprimer le modele</h1>

<div class="alert alert-warning">
    <h5>Etes-vous sur de vouloir supprimer ce modele ?</h5>
</div>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Nom :</strong> @Model.Nom</p>
        <p><strong>Marque :</strong> @Model.Marque?.Nom</p>
        <p><strong>Voitures :</strong> @Model.Voitures.Count</p>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Supprimer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>
